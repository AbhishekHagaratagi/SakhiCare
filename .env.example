# ==============================================================================
# SakhiCare 2.0 — Environment Configuration Template
# Team Nexora | CHAOS 2026
#
# Instructions:
# 1. Copy this file to .env before starting the services:
#      cp .env.example .env
# 2. Fill in your own API keys and environment URLs.
# 3. NEVER commit your actual .env file with real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend: AI Model & LLM Inference Configuration
# ------------------------------------------------------------------------------

# Google Gemini API Key for educational explanations & assistant chat
# Obtain your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Gemini Model Tag (Supported: gemini-3.8-flash, gemini-2.5-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-3.8-flash

# Ollama Local LLM Configuration (for 100% offline edge privacy)
# Install Ollama from: https://ollama.ai/
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Ollama Model Tag (Recommended: qwen2.5:3b, fits within NVIDIA Laptop GPU VRAM)
OLLAMA_MODEL=qwen2.5:3b

# Backend Service Port & Host
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ------------------------------------------------------------------------------
# Frontend: Vite & Firebase Client Configuration
# ------------------------------------------------------------------------------

# FastAPI Backend Endpoint (for browser or local device connection)
# For physical Android USB testing, use: http://localhost:8000 (with adb reverse)
# For Wi-Fi LAN testing, use your computer's LAN IP: http://192.168.x.x:8000
VITE_BACKEND_URL=http://localhost:8000

# Firebase Client Web Configuration (Authentication)
# From Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
