# ==============================================================================
# SakhiCare 2.0 — Git Ignore Configuration
# ==============================================================================

# Environment & Sensitive Keys
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Python & Virtual Environments
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node.js & Web Build
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/
dist-ssr/
*.local

# Android / Gradle Build Artifacts
.gradle/
**/.gradle/
**/build/
build/
app/build/
.kotlin/
**/.kotlin/
captures/
.externalNativeBuild/
.cxx/

# Signing & Credentials
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# OS & Editor Files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*~

# Logs & Temporary Scratch Files
*.log
scratch/
tmp/
temp/

# Keep Release APK artifact explicitly
!release/
!release/SakhiCare.apk
!release/MANIFEST.sha256
